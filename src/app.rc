#include <windows.h>
#include "resource.h"

IDI_APP ICON "..\\assets\\keyshorts.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "KeyShorts"
            VALUE "FileDescription", "Global keyboard shortcuts, remaps and macros"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "KeyShorts"
            VALUE "OriginalFilename", "KeyShorts.exe"
            VALUE "ProductName", "KeyShorts"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// The rule editor builds its controls in code so it can use the app's own
// controls and metrics. The template only carries the dialog frame.
IDD_RULE DIALOGEX 0, 0, 200, 200
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Edit rule"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
END
