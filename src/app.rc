#include <windows.h>
#include "resource.h"

IDI_APP ICON "..\\assets\\keyshorts.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "KeyShorts"
            VALUE "FileDescription", "Global keyboard shortcuts, remaps and macros"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "KeyShorts"
            VALUE "OriginalFilename", "KeyShorts.exe"
            VALUE "ProductName", "KeyShorts"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_RULE DIALOGEX 0, 0, 320, 208
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit Rule"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Name:", -1, 12, 14, 42, 10
    EDITTEXT        IDC_NAME, 58, 12, 250, 14, ES_AUTOHSCROLL
    CONTROL         "Enabled", IDC_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 58, 32, 70, 10
    LTEXT           "Trigger:", -1, 12, 53, 42, 10
    EDITTEXT        IDC_TRIGGER, 58, 51, 204, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Set...", IDC_SET_TRIGGER, 268, 50, 40, 16
    LTEXT           "Action:", -1, 12, 74, 42, 10
    COMBOBOX        IDC_TYPE, 58, 72, 132, 72, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Target:", IDC_TARGET_LABEL, 12, 95, 42, 10
    EDITTEXT        IDC_TARGET, 58, 93, 204, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_BROWSE, 268, 92, 40, 16
    PUSHBUTTON      "Set key...", IDC_SET_TARGET, 268, 92, 40, 16
    LTEXT           "Arguments:", IDC_ARGS_LABEL, 12, 116, 42, 10
    EDITTEXT        IDC_ARGS, 58, 114, 250, 14, ES_AUTOHSCROLL
    LTEXT           "Scope:", -1, 12, 137, 42, 10
    COMBOBOX        IDC_SCOPE, 58, 135, 92, 56, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_APP, 156, 135, 152, 14, ES_AUTOHSCROLL
    CONTROL         "Suppress the original key", IDC_SWALLOW, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 58, 156, 140, 10
    CONTROL         "Repeat while held (100 ms)", IDC_REPEAT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 58, 170, 150, 10
    LTEXT           "", IDC_HINT, 12, 188, 160, 14
    DEFPUSHBUTTON   "Save", IDOK, 184, 186, 60, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 248, 186, 60, 16
END
